#!/bin/sh
set -e

if ! getent group docker > /dev/null 2>&1; then
    groupadd --system docker || true
fi

if ! id -u rustploy > /dev/null 2>&1; then
    useradd --system \
        --no-create-home \
        --shell /usr/sbin/nologin \
        --groups docker \
        --comment "Rustploy daemon" \
        rustploy
fi

# Ensure /etc/rustploy/ is owned by rustploy
chown -R rustploy:rustploy /etc/rustploy 2>/dev/null || true
chmod 750 /etc/rustploy 2>/dev/null || true

CONFIG=/etc/rustploy/config.toml

# Append [env_backup] block on first install (when section is absent).
# Snapshots are written to <db_path>/env_backups/ every 60 s by default.
# See docs/env-backup.md for details and restore instructions.
if [ -f "$CONFIG" ] && ! grep -q '^\[env_backup\]' "$CONFIG"; then
    cat >> "$CONFIG" <<'EOF'

# Env var backup — snapshots automáticos de todas as env vars de projetos e serviços.
# Restaurar: rustploy env-backup list | rustploy env-backup restore <snapshot>
# Docs: /usr/share/doc/rustploy/env-backup.md
[env_backup]
# dir = "/var/lib/rustploy/db/env_backups"  # default: <db_path>/env_backups/
interval_secs = 60
EOF
fi

# config.toml may hold the API token — keep it readable only by rustploy.
chown rustploy:rustploy "$CONFIG" 2>/dev/null || true
chmod 640 "$CONFIG" 2>/dev/null || true

# Identidade age (segredos): a estrutura é [secrets] age_key_path -> arquivo 0600 do usuário
# rustploy. Nunca gera uma identidade se já existe uma (no arquivo ou inline no config): trocar
# a chave tornaria ilegíveis os segredos já cifrados.
AGE_KEY=/etc/rustploy/age.key
if [ -f "$CONFIG" ]; then
    # master_key_path não existe mais: sai do config sempre (o parse ignora a chave, mas não deixa lixo).
    sed -i '/^master_key_path *=/d' "$CONFIG"
    if grep -q '^age_key_path' "$CONFIG"; then
        AGE_KEY=$(sed -n 's/^age_key_path *= *["'"'"']\(.*\)["'"'"'].*/\1/p' "$CONFIG" | head -n1)
    elif grep -q '^\[secrets\]' "$CONFIG"; then
        sed -i "/^\[secrets\]/a age_key_path = \"$AGE_KEY\"" "$CONFIG"
    else
        printf '\n[secrets]\nage_key_path = "%s"\n' "$AGE_KEY" >> "$CONFIG"
    fi
    if [ ! -e "$AGE_KEY" ] && ! grep -q '^age_identity' "$CONFIG" && [ -x /usr/bin/rustploy-cli ]; then
        # `keygen` imprime "# chave pública: age1…" e depois a privada; o arquivo guarda só a privada.
        if /usr/bin/rustploy-cli keygen | grep -v '^#' > "$AGE_KEY.new" 2>/dev/null && [ -s "$AGE_KEY.new" ]; then
            chown rustploy:rustploy "$AGE_KEY.new" 2>/dev/null || true
            chmod 600 "$AGE_KEY.new"
            mv "$AGE_KEY.new" "$AGE_KEY"
        else
            rm -f "$AGE_KEY.new"
        fi
    fi
    [ -e "$AGE_KEY" ] && chown rustploy:rustploy "$AGE_KEY" 2>/dev/null && chmod 600 "$AGE_KEY" || true
fi

if [ "$1" = "configure" ]; then
    systemctl daemon-reload              >/dev/null 2>&1 || true
    systemctl enable  rustployd          >/dev/null 2>&1 || true
    # Helper privilegiado de firewall (socket activation): o daemon pede
    # allow/deny de portas externas via /run/rustploy/fw.sock.
    systemctl enable  rustployd-fw.socket >/dev/null 2>&1 || true
    systemctl restart rustployd-fw.socket >/dev/null 2>&1 || true
    # Helper de atualização (socket activation): só HABILITA e INICIA o socket, nunca reinicia.
    # Quem está rodando este postinst pode ser o próprio rustployd-update (uma atualização
    # pelo Settings); reiniciar o socket dele mataria o dpkg no meio. O serviço sai sozinho
    # ao fim de cada pedido, então o próximo já sobe o binário novo.
    systemctl enable  rustployd-update.socket >/dev/null 2>&1 || true
    systemctl start   rustployd-update.socket >/dev/null 2>&1 || true
    systemctl restart rustployd          >/dev/null 2>&1 || true
fi

#DEBHELPER#
